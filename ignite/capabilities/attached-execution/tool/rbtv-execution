#!/usr/bin/env node
'use strict';

// rbtv-execution — the ATTACHED EXECUTION surface, delegated to by `rbtv run <goal-folder>`.
//
// ⚠ RENAMED 7.607 E3 (design-lock item 7): the file was `attached-run/tool/rbtv-run` and the
// operand was a `runs/run-N` folder. The run layer is extinguished — the operand is the GOAL
// FOLDER, which IS the package (item 8). The umbrella verb the `rbtv` CLI routes here is still
// spelled `run`; that word belongs to `core/capabilities/rbtv-cli` and is not renamed from here.
//
// The command orchestrates and the agent is a caller (registry `concepts/rbtv-cli.md`
// § Run-verb machinery): this boots the ignite ENGINE IN-PROCESS — the same queue, tick algorithm
// and fire path the daemon runs — attached to this terminal and dying with it. It returns on
// completion or on ANY worker question, keeps its state in the goal folder, and resumes from that
// state when re-run.
//
// It owns NO advancement logic. Every decision about what advances is `engine/`'s, which is the
// daemon's. This file is argv, output and exit codes.
//
// ⚠ THERE IS NO WATCHER FOR THIS LANE, and that is RULED rather than missing
// (decisions.md#d-attached-lane-no-watcher): if this execution dies unattended it stays dead until
// you notice. Recovery is re-running this command — it resumes from the goal folder.

const path = require('node:path');

// tool/ -> attached-execution/ -> capabilities/ -> ignite/. Three levels, not four: a fourth lands on
// the rbtv root and the engine require fails with a module-not-found that names a path nobody
// wrote. Verified by running the verb, not by counting the segments.
const IGNITE_SRC = process.env.RBTV_IGNITE_SRC || path.resolve(__dirname, '..', '..', '..');
const { executeAttached, statusAttached } = require(path.join(IGNITE_SRC, 'engine', 'attached-execution.js'));
// `--relaunch` no longer builds a process-local Set: it MINTS the grant into the goal folder's own
// `relaunch-grants` file, which is the one home both lanes read (engine/relaunch-grants.js). The
// flag keeps its name and its meaning to an operator — what changed is that the grant survives this
// process, so the DAEMON lane can spend one too.
const { grantRelaunch, GRANT_FILE } = require(path.join(IGNITE_SRC, 'engine', 'relaunch-grants.js'));

const EXIT_OK = 0;
const EXIT_REFUSED = 1;
const EXIT_QUESTION = 3;   // distinct: a run that STOPPED TO ASK is not a run that finished, and a
                           // caller scripting this must be able to tell them apart without parsing
                           // prose. It is not a failure either, which is why it is not 1.

function help() {
  return [
    'rbtv run <goal-folder> [--profile <name>] [options]',
    'rbtv run <goal-folder> --status            (orient; read-only, no daemon, no profile)',
    '',
    'Boot the ignite engine IN THIS TERMINAL and advance the goal. The engine is the daemon\'s —',
    'same queue, same tick algorithm, same fire path — attached instead of detached.',
    '',
    'ARGUMENTS',
    '  <goal-folder>           .rbtv/goals/<goal>/ — the goal to advance. Its seats come from',
    '                          that folder\'s taskforce.csv, and the `after` column is the wave',
    '                          structure. There is no run folder (7.607: the package IS the goal).',
    '',
    'OPTIONS',
    '  --status                ORIENT instead of run: print done / ready / next / held-for-user',
    '                          for this goal and exit. Read-only, needs no daemon, needs no',
    '                          profile, and works before the goal has ever run.',
    '  --profile <name>        The FALLBACK launch profile, BY NAME, from the one shared config. A seat',
    '                          whose seat.md declares a harness+model cast launches on the profile THAT',
    '                          maps to instead (launch-profiles/catalog.js, applied at spawn — D19), so',
    '                          this name is read only by seats that declare no cast.',
    '                          REQUIRED ONLY IF THIS GOAL HAS SUCH A SEAT — the refusal names them.',
    '                          Passing it on a fully cast goal is legal and changes nothing.',
    '                          This verb never composes a launch command of its own.',
    '  --config <path>         the shared launch-profile config (default: the ignite config).',
    '  --tick-ms <n>           tick cadence in ms (default 10000).',
    '  --max-ticks <n>         stop after n ticks — for probes and for a single pass.',
    '  --relaunch <seat>       GRANT one seat a single fresh attempt. Repeatable. A seat whose last',
    '                          attempt failed — or a foreground seat you interrupted — is NOT retried',
    '                          on its own: seeding is create-only and a silent re-fire is how finished',
    '                          work gets run twice. This is the explicit act that runs it again, once.',
    '                          It hides nothing and rewrites nothing: the failed attempt stays on record,',
    '                          and a seat that FINISHED is never re-run by a grant.',
    `                          THE GRANT PERSISTS: it is written to <goal-folder>/${GRANT_FILE} (one`,
    '                          bare seat name per line) and is spent by whichever lane launches the',
    '                          seat — this run, a later run, or the DAEMON. A grant that could not be',
    '                          launched this pass survives to the pass that can. `rbtv goal relaunch`',
    '                          writes the same file without starting a console run.',
    '  --json                  machine-readable result on stdout.',
    '',
    'EXIT CODES',
    `  ${EXIT_OK}  the goal's execution COMPLETED, or the tick bound was reached`,
    `  ${EXIT_REFUSED}  refused, or nothing can advance (a blocked dependency chain, or a seat that failed)`,
    `  ${EXIT_QUESTION}  a worker asked a QUESTION and the execution returned to you`,
    '',
    'STATE lives in the goal folder — <goal-folder>/heart.db, this goal\'s own store. The daemon\'s',
    'store is never opened. Kill this terminal and re-run the same command: it resumes.',
    '',
    '⚠ No watcher runs for an attached execution (owner-ruled). One that dies unattended stays dead',
    '  until you notice; re-running this command is the recovery.',
  ].join('\n');
}

function parseArgs(argv) {
  const opts = { goalFolder: null, profile: null, config: null, tickMs: null, maxTicks: null, json: false, status: false, relaunch: [] };
  const rest = [];
  for (let i = 0; i < argv.length; i += 1) {
    const a = argv[i];
    if (a === '--help' || a === '-h') return { help: true };
    else if (a === '--json') opts.json = true;
    else if (a === '--status') opts.status = true;
    else if (a === '--profile') opts.profile = argv[++i];
    else if (a === '--config') opts.config = argv[++i];
    else if (a === '--tick-ms') opts.tickMs = Number(argv[++i]);
    else if (a === '--max-ticks') opts.maxTicks = Number(argv[++i]);
    else if (a === '--relaunch') opts.relaunch.push(argv[++i]);
    else if (a.startsWith('-')) return { error: `unknown flag: ${a}` };
    else rest.push(a);
  }
  if (rest.length > 1) return { error: `expected ONE goal folder, got ${rest.length}: ${rest.join(', ')}` };
  opts.goalFolder = rest[0] || null;
  return opts;
}

function refuse(message) {
  process.stderr.write(`rbtv run: ${message}\n`);
  return EXIT_REFUSED;
}

async function main(argv) {
  const opts = parseArgs(argv);
  if (opts.help) { process.stdout.write(help() + '\n'); return EXIT_OK; }
  if (opts.error) { process.stderr.write(`rbtv run: ${opts.error}\n\n${help()}\n`); return EXIT_REFUSED; }
  if (!opts.goalFolder) { process.stderr.write(`${help()}\n`); return EXIT_REFUSED; }

  if (opts.status) {
    let st;
    try {
      st = statusAttached({ goalFolder: opts.goalFolder });
    } catch (err) {
      return refuse(err.message);
    }
    if (opts.json) {
      process.stdout.write(JSON.stringify(st, null, 2) + '\n');
      return EXIT_OK;
    }
    const list = (xs) => (xs.length ? xs.join(', ') : '-');
    process.stdout.write(`\ngoal ${st.goalFolder}\n`);
    process.stdout.write(`  execution mode  ${st.executionMode}\n`);
    process.stdout.write(`  store           ${st.storePath || 'none yet — this goal has never run'}\n`);
    process.stdout.write(`  done            ${list(st.done)}\n`);
    process.stdout.write(`  in flight       ${list(st.live)}\n`);
    process.stdout.write(`  ready (next)    ${list(st.next)}\n`);
    process.stdout.write(`  waiting         ${list(st.waiting)}\n`);
    if (st.interrupted.length) {
      process.stdout.write(`\nINTERRUPTED — ${list(st.interrupted)}\n`);
      process.stdout.write('  Carried in a terminal that is gone. They read as in-flight above because\n');
      process.stdout.write('  nothing has closed the row yet; the next run closes it and then stops, and\n');
      process.stdout.write('  `--relaunch <seat>` is what gives one another attempt.\n');
    }
    if (st.heldForUser.length) {
      process.stdout.write(`\nHELD FOR YOU — ${list(st.heldForUser)}\n`);
      process.stdout.write('  These seats declare `human-interactive:` and this goal runs in interactive\n');
      process.stdout.write('  execution mode, so they need you live rather than a detached child.\n');
    }
    if (st.asks.length) {
      process.stdout.write('\nUNANSWERED QUESTIONS:\n');
      for (const a of st.asks) process.stdout.write(`  [${a.sender}] ${a.corpus}\n`);
    }
    if (!st.next.length && !st.live.length && st.waiting.length) {
      process.stdout.write('\nNothing is ready and nothing is in flight — every remaining seat waits on one\n');
      process.stdout.write('that has not finished. Re-run without --status to see the engine\'s own verdict.\n');
    }
    return EXIT_OK;
  }

  // ⚠ NO `--profile` GATE HERE, deliberately (2026-08-12, narrowing D19). Whether this goal needs
  // a fallback profile named is a question about ITS SEATS, and this file cannot see them — it
  // holds no config and reads no descriptor. `executeAttached` asks `seeding.js#uncastSeats` once
  // the config is loaded, and its refusal NAMES the seats that forced the flag. A gate here would
  // be a second, blinder answer to the same question.
  const spawnConfigPath = opts.config || path.join(IGNITE_SRC, 'config', 'spawn-profiles.yaml');

  // THE GRANT IS RECORDED BEFORE THE ENGINE BOOTS, and that ordering is the point: a run refused
  // for any reason after this line (an unknown profile, a live runner on the goal) leaves the
  // operator's authorization standing instead of losing it with the process. The engine sources it
  // from the file, so nothing is passed down — one home, read by both lanes.
  for (const seat of opts.relaunch) {
    try {
      const file = grantRelaunch(opts.goalFolder, seat);
      if (!opts.json) process.stderr.write(`relaunch GRANTED — ${seat} (${file})\n`);
    } catch (err) {
      return refuse(`could not record the relaunch grant for '${seat}': ${err.message}`);
    }
  }

  let result;
  try {
    result = await executeAttached({
      goalFolder: opts.goalFolder,
      profile: opts.profile,
      spawnConfigPath,
      tickIntervalMs: opts.tickMs || null,
      maxTicks: Number.isFinite(opts.maxTicks) ? opts.maxTicks : null,
      // The seat and the evidence ride the line — a held/skipped seat log without its seat name
      // is unactionable at the one surface a human is watching (owner feedback 2026-08-12).
      logger: opts.json ? null : (m) => {
        const seat = m.seat ? ` [${m.seat}]` : '';
        const why = m.evidence ? ` — ${String(m.evidence).split('\n')[0].slice(0, 160)}` : '';
        process.stderr.write(`${m.level || 'info'}: ${m.message}${seat}${why}\n`);
      },
    });
  } catch (err) {
    // The substrate refusal and the store refusals are TEACHING refusals — they carry the ruling,
    // the sites and the row that owns them. Print the whole message; truncating it would leave a
    // caller with "it refused" and nothing to act on.
    return refuse(err.message);
  }

  if (opts.json) {
    process.stdout.write(JSON.stringify(result, null, 2) + '\n');
  } else {
    process.stdout.write(`\nexecution ${result.outcome} — ${result.goalFolder}\n`);
    process.stdout.write(`  store   ${result.storePath}\n`);
    process.stdout.write(`  ticks   ${result.ticks} this session (tick ${result.resumedAtTick} -> ${result.tick})\n`);
    process.stdout.write(`  seats   ${result.seats.join(', ')}\n`);
    if (result.asks.length) {
      process.stdout.write('\nA WORKER ASKED — the execution stopped and handed it back to you:\n');
      for (const a of result.asks) process.stdout.write(`  [${a.sender}] ${a.corpus}\n`);
      process.stdout.write('\nAnswer it, then re-run this command to continue.\n');
    }
    if (result.reconciled && result.reconciled.length) {
      process.stdout.write(`\nINTERRUPTED EARLIER — ${result.reconciled.join(', ')}\n`);
      process.stdout.write('  A seat that was running in a terminal which is gone. Its turn was closed as\n');
      process.stdout.write('  failed; it was NOT re-fired, because a silent re-fire is how finished work runs twice.\n');
    }
    if (result.foreground && result.foreground.length) {
      process.stdout.write('\nSEATS YOU WORKED IN THIS TERMINAL:\n');
      for (const f of result.foreground) process.stdout.write(`  ${f.seat} — ${f.status}${f.signal ? ` (${f.signal})` : ''}\n`);
    }
    if (result.outcome === 'seat-failed') {
      process.stdout.write(`\nSTOPPED — a seat did not finish: ${result.unfinished.join(', ')}\n`);
      process.stdout.write('Nothing is live and nothing is queued, so no further tick can change this.\n');
    } else if (result.unfinished.length) {
      process.stdout.write(`\nBLOCKED — nothing can advance. Unfinished: ${result.unfinished.join(', ')}\n`);
      process.stdout.write('Each is waiting on a seat that has not finished. Check that seat first.\n');
    }
    // ── THE REMEDY, REACHABLE FROM BOTH VERDICTS ────────────────────────────────────────────────
    // It used to be gated on `outcome === 'seat-failed'` and therefore NEVER printed on `blocked` —
    // which is exactly the verdict a CROSS-LANE failed seat produces (the record holds it, so it is
    // `stuck`, not `failed`). The operator read "BLOCKED — nothing can advance" with no hint that a
    // relaunch is the fix. It is driven off `grantable` rather than the outcome word so it stays
    // TRUTHFUL: only seats a grant could actually release are named, and a `blocked` run whose seats
    // are merely waiting on an unmet `after` still prints nothing.
    const grantable = result.grantable || [];
    if (grantable.length) {
      process.stdout.write(`A relaunch grant can release: ${grantable.join(', ')}\n`);
      process.stdout.write(`To give one another attempt: re-run with --relaunch ${grantable[0]}\n`);
      process.stdout.write(`(or \`rbtv goal relaunch <goal> --seat ${grantable[0]}\` — the grant persists in the goal folder until it is spent, by this lane or the daemon.)\n`);
    }
  }

  if (result.outcome === 'question') return EXIT_QUESTION;
  if (result.outcome === 'blocked' || result.outcome === 'seat-failed') return EXIT_REFUSED;
  return EXIT_OK;
}

main(process.argv.slice(2))
  .then((code) => { process.exitCode = code; })
  .catch((err) => {
    process.stderr.write(`rbtv run: INTERNAL: ${err.stack || err.message}\n`);
    process.exitCode = EXIT_REFUSED;
  });
