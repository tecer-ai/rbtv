#!/usr/bin/env python3
"""rbtv-ignite-watch — the WATCH-LOOP operator surface (spec: findings/r08 § 5B + § 5C).

WHY THIS IS NOT `rbtv ignite daemon --service watch-loop`. The other three ignite services are ONE
fixed, always-installed unit each. The watch loop is a TRANSIENT unit PER RUN —
`rbtv-watch-<sha1(str(package))[:12]>`, created by `systemd-run` when the self-heal job relaunches
it (`jobs/jobcontain.py` unit_name/detach_argv). There can be zero, one, or — across two
simultaneous runs — several, under different names. Its target is a RUN PACKAGE and the unit name
is DERIVED from it: a target shape `daemon-operator` has no analog for, which is why this is its
own capability rather than another `--service` row.

NOTHING HERE IS A SECOND IMPLEMENTATION (`PRIN-11`):

  which run is live      -> jobs/selfheal-watch.py `resolve_package()` (the register's ONE reader,
                            which REFUSES rather than guessing when zero or two runs read open)
  which unit that is     -> jobs/jobcontain.py `unit_name()` — the SAME digest. Computing it here
                            would let this surface and the self-heal job name different units for
                            the same run, each blind to the other's watcher.
  unit/stop/kill/restart -> capabilities/daemon-operator, as a subprocess steered by
                            RBTV_IGNITE_UNIT — its survival checks and health verdict, unchanged
  the launch argv        -> the same argv selfheal-watch.py builds (`--loop-forever`, NO cadence
                            number: a relaunch that carries the number is a second home for it)
  reading the cadence    -> team-kit/budget.py `read_cadence()`

⚠ `heartbeat-set` IS NOT THE TICKER'S CADENCE, and the two share only a retired word. `heartbeat`
is RETIRED for the ticker engine (ignite/CLAUDE.md § Terminology); the acceptance list's "heartbeat
(set time)" is the WATCH LOOP's own liveness-pass cadence, whose one home is
`{package}/budget.json` -> `cadence.watch_loop_max_seconds`. The ticker's cadence is a different,
already-built surface (`rbtv ignite ticker set-interval`). Setting one while meaning the other
fails silently and completely, which is why this note is at the top of the file.

WRITE-THEN-RESTART, NOT LIVE RELOAD — the same ratified posture the ticker carries. `watch.py`
resolves its cadence ONCE, in main(), before the loop starts; an edit to budget.json while a loop
runs has NO effect until that loop is relaunched. The verb says so, and `--restart` performs it.

Exit codes (the sd-graph / rbtv-goal convention, extended by exactly the two `rbtv-ignite-ticker`
already extends it by):
  0  the act succeeded / the read succeeded
  1  the act was refused, or the read FAILED
  2  usage error
  3  the cadence is out of range — NOTHING was written
  4  the write landed but the restart failed (the edit is durable and is NOT reverted)
"""

import argparse
import importlib.util
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
IGNITE = HERE.parents[2]
JOBS = IGNITE / "jobs"
TEAM_KIT = IGNITE / "team-kit"
GOALS_TREE_TOOL = IGNITE / "capabilities" / "goals-tree" / "tool"
DAEMON_OPERATOR = IGNITE / "capabilities" / "daemon-operator" / "tool" / "rbtv-ignite-daemon"
WATCH_PY = TEAM_KIT / "watch.py"
COORD_PY = TEAM_KIT / "coord.py"

# This surface's own prints must interleave CORRECTLY with a delegate's, which writes straight to
# fd 1. Without this the block buffer flushed LAST and the delegate's output appeared FIRST —
# observed, and it read as though the restart had happened before the write.
sys.stdout.reconfigure(line_buffering=True)

UNIT_PREFIX = "rbtv-watch"

# ⚠ THE ONE ENFORCEMENT POINT OF `r-watch-loop-30s` (owner, 2026-07-30: the watch loop's cadence is
# 30 SECONDS MAXIMUM). budget.py's read_cadence() checks only "positive integer" — it bounds
# nothing — so until this verb existed the ruling had no code that could refuse a breach. This is
# a GATE, not a home: the VALUE still lives in each run's budget.json and is read from there,
# never defaulted from here. A number hand-edited into budget.json past this gate is still
# accepted by every reader (disclosed, not fixed here — that needs budget.py's own reader).
CEILING_S = 30
CADENCE_FIELD = "watch_loop_max_seconds"


def die(msg, code=1):
    sys.stderr.write(f"rbtv-ignite-watch: {msg}\n")
    sys.exit(code)


def _load_module(name, path):
    """Import a sibling by PATH — `selfheal-watch.py` is not a legal module name."""
    spec = importlib.util.spec_from_file_location(name, path)
    if spec is None or spec.loader is None:
        die(f"cannot load {path}", 1)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def selfheal():
    return _load_module("selfheal_watch", JOBS / "selfheal-watch.py")


def budget():
    return _load_module("budget", TEAM_KIT / "budget.py")


# ---------------------------------------------------------------- target resolution

def goal_dir(goal):
    """A goal FOLDER from `--goal`: an existing path wins; else a NAME under `.rbtv/goals`.

    The name branch delegates to the goals-tree capability's own two resolvers rather than walking
    up for `.rbtv/goals` a second time — and gets its escape refusal (a name is one folder directly
    under the root, never a path) for free.
    """
    p = Path(goal).expanduser()
    if p.is_dir():
        return p.resolve()
    if os.sep in goal:
        die(f"--goal {goal}: not a directory (it looks like a path, so it was not tried as a name)")
    sys.path.insert(0, str(GOALS_TREE_TOOL))
    import goal_cli  # noqa: E402  — the goals-tree capability's resolvers; see this docstring
    try:
        root = goal_cli.resolve_goals_root(None)
        d = goal_cli.resolve_goal_dir(root, goal)
    except goal_cli.Refusal as exc:
        die(str(exc))
    if not d.is_dir():
        die(f"--goal {goal}: no such goal under {root} (walked up from {Path.cwd()}). Pass the "
            f"goal folder's path instead if the workspace is elsewhere.")
    return d


def resolve_target(args, sw):
    """(package, provenance) — the run package this verb acts on, or a refusal that exits 1."""
    if not args.package and not args.goal:
        die("name the target: --package <abs-path> or --goal <name-or-path>", 2)
    ns = argparse.Namespace(
        package=args.package,
        goal=str(goal_dir(args.goal)) if args.goal and not args.package else None,
        coord=str(COORD_PY),
    )
    package, provenance = sw.resolve_package(ns)
    if package is None:
        # FAIL CLOSED. The resolver refuses rather than guessing when the LEASE does not name
        # exactly one live room; acting on a guessed package is the G-305 defect shape.
        die(f"cannot resolve which package to act on: {provenance}")
    return package, provenance


def unit_for(package, sw):
    return sw.jobcontain.unit_name(UNIT_PREFIX, package)


def unit_loaded(unit):
    r = subprocess.run(["systemctl", "--user", "show", unit, "-p", "LoadState", "--value"],
                       capture_output=True, text=True)
    return r.stdout.strip() == "loaded"


def delegate(verb, unit, extra=()):
    """Run the daemon-operator verb against `unit`. Its stdout/stderr/exit code are the answer."""
    env = dict(os.environ, RBTV_IGNITE_UNIT=unit)
    r = subprocess.run([str(DAEMON_OPERATOR), verb, *extra], env=env)
    return r.returncode


# ---------------------------------------------------------------- verbs

def cmd_start(package, unit, sw, args):
    """`start` is the ASYMMETRIC verb: there is no unit to start until the first launch.

    For the three fixed services `start` and `restart` differ only in whether the unit was already
    up. Here `start` CREATES the transient unit (systemd-run) around a fresh `watch.py`, while
    `restart` acts on one that already exists. `--help` says so, because a caller who assumes the
    fixed-unit symmetry writes `restart` and gets a refusal.
    """
    others = sw.live_watchers(package)
    if others:
        # Same refusal the self-heal job makes, for the same reason: a run never carries two watch
        # loops, and systemd's own --unit= collision refusal is only the second guard.
        die(f"REFUSING — a live watch.py is already bound to this package: pid(s) {others}. "
            f"A run never carries two watch loops. Stop that one first, or use `restart`.")
    cmd = [sys.executable, str(WATCH_PY), "--package", str(package)]
    if args.notify:
        cmd.append("--notify")
    # NO CADENCE VALUE CROSSES THIS BOUNDARY (the self-heal job's own rule): `--loop-forever`
    # carries no number, so watch.py resolves the run's declared cadence itself at start.
    cmd.append("--loop-forever")
    cmd += list(args.watch_arg)
    launch, launched_unit = sw.jobcontain.detach_argv(cmd, unit)

    if args.dry_run:
        print(f"DRY-RUN — would launch: {' '.join(launch)}")
        return 0

    # No preexec_fn: unlike the self-heal job this process never called jobcontain.contain(), so
    # there are no lowered limits for a child to inherit and nothing to restore.
    res = subprocess.run(launch, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         stdin=subprocess.DEVNULL, timeout=60)
    out = (res.stdout or b"").decode("utf-8", "replace").strip()
    if out:
        print(f"  launcher| {out}")
    # The launcher's exit code is not the verdict — a LIVE watch.py is.
    for _ in range(20):
        back = sw.live_watchers(package)
        if back:
            print(f"STARTED AND VERIFIED ALIVE — pid(s) {back}"
                  + (f", unit {launched_unit}" if launched_unit else " (no systemd-run: bare child)"))
            return 0
        time.sleep(0.5)
    die(f"LAUNCH DID NOT TAKE — no live watch.py for this package after 10s "
        f"(launcher exit {res.returncode}). Fall back by hand: "
        f"nohup {' '.join(cmd)} >/dev/null 2>&1 &")


def cmd_restart(package, unit, sw, args):
    if not unit_loaded(unit):
        die(f"no watch unit to restart: {unit} is not loaded (no watch loop has been launched for "
            f"this package, or it already exited — a --collect transient unit is removed when it "
            f"stops). Use `start`, which creates the unit.")
    return delegate("restart", unit)


def cmd_heartbeat_show(package, unit, sw, args):
    b = budget()
    path = package / "budget.json"
    try:
        seconds = b.read_cadence(package)
    except (b.CadenceUndeclared, b.CadenceUnreadable) as exc:
        die(str(exc))
    print(f"package   {package}")
    print(f"file      {path} (cadence.{CADENCE_FIELD})")
    print(f"cadence   {seconds}s   (ceiling {CEILING_S}s — r-watch-loop-30s)")
    live = sw.live_watchers(package)
    print(f"live loop {'pid(s) ' + str(live) if live else 'none running'}"
          f" — a running loop keeps the cadence it resolved AT LAUNCH, not this value")
    return 0


def _write_cadence(path, seconds):
    """Set cadence.<field>, preserving every other key AND the file's own indentation.

    A budget.json is prose-heavy and hand-authored (its writer is the master). Re-indenting it on a
    machine write would bury a one-number change in a whole-file diff, so the existing indent is
    sniffed and reused. Written via a temp file + rename: a crash mid-write must never leave a run
    holding a truncated budget.
    """
    raw = path.read_text(encoding="utf-8") if path.exists() else None
    data = json.loads(raw) if raw else {}
    if not isinstance(data, dict):
        die(f"{path} does not hold a JSON object")
    m = re.match(r"\{\s*\n(\s+)\S", raw) if raw else None
    indent = len(m.group(1)) if m else 2
    cadence = data.get("cadence")
    if not isinstance(cadence, dict):
        cadence = {}
        data["cadence"] = cadence
    before = cadence.get(CADENCE_FIELD)
    cadence[CADENCE_FIELD] = seconds
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=indent, ensure_ascii=False) + "\n", encoding="utf-8")
    os.replace(tmp, path)
    return before, raw is None


def cmd_heartbeat_set(package, unit, sw, args):
    seconds = args.seconds
    if seconds <= 0 or seconds > CEILING_S:
        # REFUSED BEFORE ANYTHING IS WRITTEN (the ticker's own shape): an out-of-range value leaves
        # the file byte-identical, so a refusal can never be mistaken for a partial edit.
        sys.stderr.write(
            f"rbtv-ignite-watch: REFUSED, nothing written: {seconds}s is outside "
            f"1..{CEILING_S}s.\n  the ceiling is owner ruling `r-watch-loop-30s` (30 seconds "
            f"MAXIMUM); a cadence must also be a positive number of seconds.\n")
        sys.exit(3)

    path = package / "budget.json"
    before, created = _write_cadence(path, seconds)
    b = budget()
    # Read it BACK off disk through the same reader every consumer uses — a write this surface
    # believes it made is not the claim; what the readers now see is.
    readback = b.read_cadence(package)
    if readback != seconds:
        die(f"WROTE {seconds} BUT {path} READS BACK {readback} — do not trust either; inspect the "
            f"file by hand", 1)

    if created:
        print(f"created  {path} (it did not exist; it now declares only the cadence)")
    was = "unset" if before is None else f"{before}s"
    print(f"cadence.{CADENCE_FIELD}  {was} -> {seconds}s")
    print(f"written  {path}")
    print(f"readback {readback}s (via budget.py read_cadence — the reader every consumer uses)")

    if not args.restart:
        print(f"\nNOT IN EFFECT YET. The watch loop resolves its cadence ONCE, at launch, and never "
              f"re-reads it.\n"
              f"  put it in effect:  rbtv ignite watch heartbeat-set {seconds} --restart "
              f"{'--package ' + str(package) if args.package else '--goal ' + str(args.goal)}\n"
              f"             or:     rbtv ignite watch restart (a loop already running)\n"
              f"                     rbtv ignite watch start   (none running)\n")
        return 0

    if unit_loaded(unit):
        print(f"\nrestarting the watch loop ({unit}) so the new cadence takes effect...")
        rc = delegate("restart", unit)
        act = "restart"
    else:
        print(f"\nno watch loop is running for this package — starting one so the new cadence "
              f"takes effect...")
        # cmd_start REFUSES BY EXITING (double-start, launch-did-not-take). Uncaught, that exit is
        # 1 — "the act was refused" — which reads as NOTHING HAPPENED to a caller whose edit has
        # ALREADY landed on disk. The write is durable on both arms, so both must reach the exit-4
        # branch below; exit 4 was unreachable through this arm.
        try:
            rc = cmd_start(package, unit, sw, args)
        except SystemExit as exc:
            rc = exc.code if isinstance(exc.code, int) else 1
        act = "start"
    if rc != 0:
        # LOUD, and the write is NOT undone: the edit is durable and correct, only unapplied.
        # Reverting would leave the operator believing the failure had also lost their change.
        sys.stderr.write(
            f"rbtv-ignite-watch: THE EDIT IS WRITTEN BUT THE {act.upper()} FAILED (exit {rc}).\n"
            f"  the new cadence is NOT running. Fix that, then `rbtv ignite watch {act}`.\n")
        sys.exit(4)
    print(f"cadence {seconds}s is now in effect.")
    return 0


# ---------------------------------------------------------------- selftest

def cmd_selftest(_args):
    """Exercise the cadence path end to end against a THROWAWAY package.

    It never derives a lease, never launches watch.py and never touches systemd — those halves
    are proven by the daemon-operator selftest and by the live captures. What is unique here, and
    what silently breaks, is the WRITE: the ceiling gate, key preservation, and the read-back.
    """
    import tempfile
    fails = 0

    def check(name, ok, detail=""):
        nonlocal fails
        if ok:
            print(f"PASS  {name}")
        else:
            print(f"FAIL  {name} {detail}")
            fails += 1

    with tempfile.TemporaryDirectory() as td:
        pkg = Path(td) / "run-x"
        pkg.mkdir()
        bj = pkg / "budget.json"
        bj.write_text(json.dumps({
            "schema": "run-budget/1",
            "floors": {"launch_refuse_mb": 2000},
            "cadence": {CADENCE_FIELD: 30, "ruling": "r-watch-loop-30s"},
        }, indent=1) + "\n", encoding="utf-8")

        def run(*argv):
            return subprocess.run([sys.executable, str(Path(__file__).resolve()), *argv],
                                  capture_output=True, text=True)

        r = run("heartbeat-set", "20", "--package", str(pkg))
        check("heartbeat-set 20 succeeds", r.returncode == 0, f"(exit {r.returncode}: {r.stderr})")
        data = json.loads(bj.read_text(encoding="utf-8"))
        check("the value landed", data["cadence"][CADENCE_FIELD] == 20, f"(got {data['cadence']})")
        check("every other key survives",
              data.get("schema") == "run-budget/1"
              and data["floors"]["launch_refuse_mb"] == 2000
              and data["cadence"].get("ruling") == "r-watch-loop-30s", f"(got {data})")

        r = run("heartbeat-show", "--package", str(pkg))
        check("heartbeat-show reads 20 back", r.returncode == 0 and "cadence   20s" in r.stdout,
              f"(exit {r.returncode}: {r.stdout})")

        frozen = bj.read_bytes()
        r = run("heartbeat-set", "45", "--package", str(pkg))
        check("over the 30s ceiling refuses with exit 3", r.returncode == 3, f"(exit {r.returncode})")
        check("a refused set writes NOTHING", bj.read_bytes() == frozen)
        # A dry run may NEVER be reported as an applied one: this combination used to write the
        # value, launch nothing, and print "is now in effect" with exit 0.
        r = run("heartbeat-set", "9", "--restart", "--dry-run", "--package", str(pkg))
        check("--dry-run on heartbeat-set is a usage error, not a false 'in effect'",
              r.returncode == 2 and "in effect" not in r.stdout, f"(exit {r.returncode}: {r.stdout})")
        check("the refused dry-run wrote nothing", bj.read_bytes() == frozen)
        r = run("heartbeat-set", "0", "--package", str(pkg))
        check("a non-positive cadence refuses with exit 3", r.returncode == 3, f"(exit {r.returncode})")
        check("a refused set STILL writes nothing", bj.read_bytes() == frozen)

        # An empty package: the file is created rather than the verb refusing.
        fresh = Path(td) / "run-y"
        fresh.mkdir()
        r = run("heartbeat-set", "5", "--package", str(fresh))
        check("a package with no budget.json gets one",
              r.returncode == 0 and json.loads((fresh / "budget.json").read_text())["cadence"][CADENCE_FIELD] == 5,
              f"(exit {r.returncode}: {r.stderr})")

        # The unit name MUST be the name the self-heal job computes, or the two surfaces would name
        # different units for the same run and each would be blind to the other's watcher. The
        # expectation is SPELLED OUT rather than read back from unit_name(): an expectation that
        # calls the function under test moves with it and would pass any change to either the
        # prefix or the digest.
        import hashlib
        sw = selfheal()
        p = Path(td).resolve() / "run-x"
        want = "rbtv-watch-" + hashlib.sha1(str(p).encode("utf-8")).hexdigest()[:12]
        check("the unit name is the self-heal job's own name for this package",
              unit_for(p, sw) == want, f"(got {unit_for(p, sw)}, wanted {want})")

        r = run("unit", "--package", str(pkg), "--json")
        check("unit on a package with no live loop refuses (exit 1), never a false healthy",
              r.returncode == 1 and '"read_ok":false' in r.stdout, f"(exit {r.returncode}: {r.stdout})")

    if fails:
        print(f"selftest FAIL ({fails} failures)")
        return 1
    print("selftest PASS (0 failures)")
    return 0


# ---------------------------------------------------------------- argv

VERBS = ("unit", "start", "restart", "stop", "kill", "heartbeat-show", "heartbeat-set", "selftest")


def main():
    ap = argparse.ArgumentParser(
        prog="rbtv-ignite-watch",
        description="The watch-loop operator surface: power verbs for a RUN's transient watch unit, "
                    "and the watch cadence (NOT the ticker's — see `rbtv ignite ticker`).",
        epilog="⚠ `start` and `restart` are NOT symmetric here. There is no unit until the first "
               "launch: `start` CREATES the transient unit around a fresh watch.py; `restart` acts "
               "on one that already exists and refuses when none does.")
    ap.add_argument("verb", choices=VERBS)
    ap.add_argument("seconds", nargs="?", type=int, help="heartbeat-set only: the new cadence in "
                                                         f"seconds (1..{CEILING_S})")
    ap.add_argument("--package", default=None, help="the package to act on (absolute path)")
    ap.add_argument("--goal", default=None, help="a goal NAME under .rbtv/goals (or a goal folder "
                                                 "path); the package is DERIVED from the goal's "
                                                 "LIVE LEASE, and an unreadable lease, no room or "
                                                 "two rooms are refused, never guessed")
    ap.add_argument("--restart", action="store_true", help="heartbeat-set: apply it now")
    ap.add_argument("--notify", action="store_true", help="start: launch watch.py with --notify")
    ap.add_argument("--watch-arg", action="append", default=[],
                    help="start: extra argument passed through to watch.py, repeatable. The live "
                         "sensor runs with --mem-floor-mb; a start that drops it launches a WEAKER "
                         "sensor than the one the goal had")
    ap.add_argument("--dry-run", action="store_true", help="start: print the launch argv, launch nothing")
    ap.add_argument("--json", action="store_true", help="unit: machine-readable output")
    args = ap.parse_args()

    # `heartbeat-set N --restart --dry-run` WROTE the value, launched nothing, and still printed
    # "cadence Ns is now in effect" with exit 0 — a success this surface never performed. A dry run
    # belongs to `start` alone, and a refusal here lands BEFORE the write.
    if args.dry_run and args.verb != "start":
        ap.error("--dry-run applies to `start` only (it launches nothing, so it can never put a "
                 "cadence into effect)")

    if args.verb == "selftest":
        return cmd_selftest(args)
    if args.verb == "heartbeat-set" and args.seconds is None:
        ap.error(f"heartbeat-set needs a cadence in seconds (1..{CEILING_S})")

    sw = selfheal()
    package, provenance = resolve_target(args, sw)
    unit = unit_for(package, sw)
    if args.verb not in ("heartbeat-show", "heartbeat-set"):
        # The provenance is stated, never implicit: which run this acts on is the whole question,
        # and a resolver that resolves correctly and prints nothing cannot be audited.
        print(f"target  {package}\n        via {provenance}\n        unit {unit}", file=sys.stderr)

    if args.verb == "start":
        return cmd_start(package, unit, sw, args)
    if args.verb == "restart":
        return cmd_restart(package, unit, sw, args)
    if args.verb in ("unit", "stop", "kill"):
        return delegate(args.verb, unit, ["--json"] if (args.json and args.verb == "unit") else [])
    if args.verb == "heartbeat-show":
        return cmd_heartbeat_show(package, unit, sw, args)
    if args.verb == "heartbeat-set":
        return cmd_heartbeat_set(package, unit, sw, args)
    return 2


if __name__ == "__main__":
    sys.exit(main())
