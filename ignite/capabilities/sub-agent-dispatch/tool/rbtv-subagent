#!/usr/bin/env node
'use strict';

// rbtv-subagent — the CLI-lane sub-agent dispatch capability (task 7.43).
//
// Launches a headless sub-agent ATTACHED to the caller's terminal: it runs in the foreground of
// this invocation, its output returns here and nowhere else, and it dies when this process does.
//
// The cage it enforces is CMP-10 § Standing sub-agent lane, `restrictions`-class — fail-closed in
// this capability's own code. Every refusal below is a typed error and a non-spawn; there is no
// `--force`, no `--allow`, and no environment override on any of them, because an escape hatch on
// a fail-closed bound is the bound's repeal.
//
// Verbs:
//   dispatch --target <part-id> --profile <name> [--task <text>] [--effort low|medium|high|max]
//            [--resumable] [--json]        (task text may also arrive on stdin)
//   targets                                 what the exposure manifests expose for sub-agent dispatch
//   doctor                                  the cage's own readout: catalog, cap, allowlist, PATH

const fs = require('node:fs');
const path = require('node:path');

const lane = require('..');
const catalog = require('../catalog');
const fanout = require('../fanout');
const { DispatchError } = require('../errors');

function fail(err, json) {
  const code = err && err.code ? err.code : 'E_UNEXPECTED';
  if (json) {
    process.stdout.write(`${JSON.stringify({ ok: false, code, error: err.message, details: err.details || null }, null, 2)}\n`);
  } else {
    process.stderr.write(`rbtv-subagent: ${code}\n${err.message}\n`);
  }
  // 3 = a cage refusal (the launch was denied); 1 = anything else.
  process.exit(err instanceof DispatchError || err.name === 'SpawnError' || err.name === 'LadderError' ? 3 : 1);
}

function parseArgs(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--json') out.json = true;
    else if (a === '--resumable') out.resumable = true;
    else if (a.startsWith('--')) { out[a.slice(2)] = argv[i + 1]; i += 1; }
    else out._.push(a);
  }
  return out;
}

function readStdinSync() {
  try {
    if (process.stdin.isTTY) return '';
    return fs.readFileSync(0, 'utf8');
  } catch {
    return '';
  }
}

async function main() {
  const [, , verb, ...rest] = process.argv;
  const args = parseArgs(rest);

  if (!verb || verb === '--help' || verb === '-h' || verb === 'help') {
    process.stdout.write(fs.readFileSync(path.join(__dirname, '..', 'USAGE.txt'), 'utf8'));
    return;
  }

  if (verb === 'targets') {
    const cat = catalog.loadCatalog();
    if (args.json) {
      process.stdout.write(`${JSON.stringify({ ok: true, manifests: cat.manifests, targets: cat.entries }, null, 2)}\n`);
      return;
    }
    process.stdout.write(`exposure manifests read (${cat.manifests.length}):\n`);
    for (const m of cat.manifests) process.stdout.write(`  ${m}\n`);
    process.stdout.write(`\ndispatchable targets (method='${catalog.DISPATCHABLE_METHOD}') — ${cat.entries.length}:\n`);
    for (const e of cat.entries) process.stdout.write(`  ${e.partId}  [${e.partKind}]  -> ${e.entryPoint}\n`);
    return;
  }

  if (verb === 'doctor') {
    let cat = null;
    let catalogError = null;
    try { cat = catalog.loadCatalog(); } catch (err) { catalogError = err.code || err.message; }
    const sid = fanout.dispatcherId();
    const runtimeRoot = path.join(require('../dispatch').resolveWorkspaceRoot() || '', '.rbtv', 'runtime');
    const live = fanout.liveClaims(fanout.registryDir(runtimeRoot, sid));
    const readout = {
      ok: true,
      catalog: catalogError ? { error: catalogError } : { manifests: cat.manifests, targets: cat.entries.map((e) => e.partId) },
      fanout: { dispatcherSession: sid, live: live.length, max: fanout.FANOUT_MAX },
      environment: { base: lane.BASE_PASSTHROUGH, childPath: lane.MINIMAL_PATH, depthVar: lane.DEPTH_VAR },
      nested: process.env[lane.DEPTH_VAR] !== undefined,
    };
    process.stdout.write(`${JSON.stringify(readout, null, 2)}\n`);
    return;
  }

  if (verb !== 'dispatch') {
    fail(new DispatchError('E_BAD_REQUEST', `unknown verb '${verb}' (known: dispatch, targets, doctor)`), args.json);
    return;
  }

  const task = args.task !== undefined ? args.task : readStdinSync();
  const result = await lane.dispatch({
    target: args.target,
    profile: args.profile,
    task,
    effort: args.effort || null,
    needResumable: Boolean(args.resumable),
    // stream the sub-agent's output to this terminal as it arrives — "attached to the caller's
    // terminal" is the lane's whole shape, not a formatting choice.
    onStdout: args.json ? null : (b) => process.stdout.write(b),
    onStderr: args.json ? null : (b) => process.stderr.write(b),
  });

  if (args.json) {
    process.stdout.write(`${JSON.stringify({ ok: result.exitCode === 0, ...result }, null, 2)}\n`);
  } else {
    process.stderr.write(
      `\n-- sub-agent ${result.target} via ${result.profile} (${result.harness}, rung ${result.rung}) ` +
      `exit ${result.exitCode}${result.signal ? ` signal ${result.signal}` : ''}\n` +
      `-- workdir ${result.workdir}\n`,
    );
  }
  process.exit(result.exitCode === 0 ? 0 : 2);
}

main().catch((err) => fail(err, process.argv.includes('--json')));
