{
  "description": "Slack messages, files, reactions and canvases; agent scheduling and reply orchestration belong in Ignite.",
  "dependencies": [
    {
      "name": "git",
      "install": "https://git-scm.com/downloads",
      "command": "git"
    },
    {
      "name": "python",
      "install": "https://www.python.org/downloads/"
    }
  ],
  "type": "messaging",
  "provides": [
    "message.send",
    "message.receive",
    "message.history",
    "message.react",
    "message.file",
    "group.manage",
    "approval.secure"
  ],
  "repository": {
    "url": "https://github.com/tecer-ai/slack-tools",
    "branch": "feat/stools-cli",
    "requirements": "requirements.txt"
  }
}
