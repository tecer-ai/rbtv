{
  "description": "Google Workspace APIs for Gmail, Calendar, Drive and Meet; other providers belong in their own connector components.",
  "dependencies": [
    {
      "name": "git",
      "install": "https://git-scm.com/downloads",
      "command": "git"
    },
    {
      "name": "python",
      "install": "https://www.python.org/downloads/"
    }
  ],
  "type": "messaging",
  "serves": [
    "calendar",
    "storage",
    "media"
  ],
  "provides": [
    "message.send",
    "message.history",
    "message.receive",
    "calendar.list",
    "calendar.create",
    "calendar.update",
    "calendar.delete",
    "calendar.restore",
    "storage.list",
    "storage.search",
    "storage.download",
    "storage.upload",
    "storage.create-folder",
    "storage.move",
    "storage.trash",
    "storage.list-drives"
  ],
  "repository": {
    "url": "https://github.com/tecer-ai/google-tools",
    "branch": "feat/gtools-cli",
    "requirements": "requirements.txt"
  }
}
