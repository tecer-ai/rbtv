#!/usr/bin/env python3
"""rbtv-install — the SECOND rbtv installer: KG-shape components, new standards.

Built for core-build task 7.64. The first installer (`install.py` at the repo
root) is UNTOUCHED and keeps serving today's flat module components; this one
serves the CMP-5 component-first shape and realizes exposure through CMP-12's
adapter matrix. The two coexist deliberately.

    rbtv-install list      --catalog-root R
    rbtv-install install   --catalog-root R --target W [--module M] [--component C]
    rbtv-install doctor    --catalog-root R
    rbtv-install selftest

`--catalog-root` is EXPLICIT and REQUIRED everywhere it appears. It is never
inferred: with the CMP-5 tree unbuilt in the repo (issue G-109) a guessed root
would silently resolve into a tree with no such shape, and a wrong-but-plausible
install is worse than a refusal that names its reason.

A catalog root is EITHER the rbtv repo OR an install's `.rbtv/mirror/`, and this
tool cannot tell them apart by design (CMP-3 — mirror and repo are equivalent;
moving meta components from `mirror/meta/` into `rbtv/` later must change nothing
about how components work).

Exit codes (the sd-graph / rbtv-goal / daemon-operator convention):
    0 success · 1 refusal or not-found · 2 usage error

Contract, reasoning and divergences: `../installer.md`.
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))

import adapters  # noqa: E402
import catalog  # noqa: E402

VERSION = "0.1.0-standin"
MARK_START = "<!-- rbtv-install:start id={id} -->"
MARK_END = "<!-- rbtv-install:end id={id} -->"


class Refusal(Exception):
    """Exit 1 — a named refusal."""


def _now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


# ---------------------------------------------------------------- writing


def _write_whole(path: Path, body: str) -> None:
    """Atomic whole-file write for files this installer OWNS."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix=".rbtv-install.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(body)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


def _write_block(path: Path, part_id: str, body: str) -> None:
    """Edit a managed marker block inside a file we SHARE with other content.

    CLAUDE.md / AGENTS.md / settings.json belong to the workspace, not to us.
    Overwriting one whole would destroy hand-authored content — so an
    `agents.md`, `hook` or `config` row edits its own block and nothing else.
    """
    start = MARK_START.format(id=part_id)
    end = MARK_END.format(id=part_id)
    block = f"{start}\n{body.rstrip()}\n{end}\n"

    existing = path.read_text(encoding="utf-8") if path.exists() else ""
    if start in existing and end in existing:
        head, _, rest = existing.partition(start)
        _, _, tail = rest.partition(end)
        new = f"{head}{block}{tail.lstrip(chr(10))}"
    else:
        sep = "" if not existing or existing.endswith("\n\n") else ("\n" if existing.endswith("\n") else "\n\n")
        new = f"{existing}{sep}{block}"
    _write_whole(path, new)


def _skill_file(body: str, name: str, description: str) -> str:
    """A skill-format file: frontmatter the harness reads + the authored body."""
    desc = (description or f"the {name} entry point").replace("\n", " ").strip()
    return f"---\nname: {name}\ndescription: {desc}\n---\n\n{body.strip()}\n"


# ---------------------------------------------------------------- install state


def _install_state(target: Path, module: str, actions: list[dict], dry_run: bool) -> list[dict]:
    """Per CMP-1's install model: `.rbtv/modules/{module}/`.

    status.json is FIRST-RUN SEED ONLY — the daemon never rewrites it, so a
    direct reader is misled. `installed` is DERIVED from a valid server.json,
    which is the DAEMON's file and is never written here.
    """
    base = target / ".rbtv" / "modules" / module
    status = base / "status.json"
    settings = base / "settings.json"
    history = base / "settings-history.jsonl"
    written: list[dict] = []

    first_run = not status.exists()
    if first_run:
        seed = {
            "module": module,
            "version": VERSION,
            "first_run": _now(),
            "installer": "rbtv-install (CMP-5 shape)",
            "note": (
                "seed only — the daemon never rewrites this file. Derive `installed` "
                "from a valid server.json (CMP-1), never from a stored boolean."
            ),
        }
        written.append({"path": str(status), "kind": "status.json", "action": "seed"})
        if not dry_run:
            _write_whole(status, json.dumps(seed, indent=2) + "\n")
        if not settings.exists():
            written.append({"path": str(settings), "kind": "settings.json", "action": "seed"})
            if not dry_run:
                _write_whole(settings, json.dumps({"machines": {}}, indent=2) + "\n")

    entry = {
        "ts": _now(),
        "machine": os.uname().nodename,
        "key": f"modules.{module}.installed_parts",
        "from": None,
        "to": len(actions),
        "by": "rbtv-install",
    }
    written.append({"path": str(history), "kind": "settings-history.jsonl", "action": "append"})
    if not dry_run:
        history.parent.mkdir(parents=True, exist_ok=True)
        with history.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(entry) + "\n")
    return written


# ---------------------------------------------------------------- the install


def do_install(root: Path, target: Path, only_module: str | None,
               only_component: str | None, harnesses: list[str],
               dry_run: bool) -> dict:
    modules = catalog.discover(root)
    if not modules:
        raise Refusal(
            f"no KG-shape module under --catalog-root {root} — a module is a "
            "directory holding `module.md` (CMP-5). Nothing installed."
        )
    if only_module:
        if only_module not in modules:
            raise Refusal(
                f"module {only_module!r} not under {root}. Found: "
                f"{', '.join(sorted(modules)) or '(none)'}"
            )
        modules = {only_module: modules[only_module]}

    actions: list[dict] = []
    skipped: list[dict] = []

    for mod in modules.values():
        # 1. The module entry point -> the module DISCOVERY SKILL on each harness.
        #    `module.md` is skill-format already; the installer realizes it.
        if mod.entry_point is not None:
            body = mod.entry_point.read_text(encoding="utf-8")
            desc = catalog.description_of(mod.entry_point) or f"the {mod.name} module"
            stripped = catalog._FRONTMATTER.sub("", body, count=1).strip()
            for harness in harnesses:
                rel, real = adapters.realize("skill", harness, f"rbtv-{mod.name}")
                dest = target / rel
                actions.append({
                    "module": mod.name, "part": f"{mod.name}:module-entry-point",
                    "method": "skill", "harness": harness, "path": str(dest),
                    "native": real.native, "source": str(mod.entry_point),
                })
                if not dry_run:
                    _write_whole(dest, _skill_file(stripped, f"rbtv-{mod.name}", desc))

        comps = mod.components
        if only_component:
            if only_component not in comps:
                raise Refusal(
                    f"component {only_component!r} not in module {mod.name!r}. "
                    f"Found: {', '.join(sorted(comps)) or '(none)'}"
                )
            comps = {only_component: comps[only_component]}

        # 2. Every exposure row, realized through CMP-12's map.
        for comp in comps.values():
            rows = comp.exposure_rows()
            if not rows:
                skipped.append({
                    "component": f"{mod.name}/{comp.name}",
                    "reason": "no exposure.csv — the component exposes nothing (not a defect)",
                })
                continue
            for row in rows:
                part_id = (row.get("part-id") or "").strip()
                method = (row.get("method") or "").strip()
                entry = (row.get("entry-point") or "").strip()
                if not part_id or not method:
                    raise Refusal(
                        f"exposure.csv row in {mod.name}/{comp.name} is missing "
                        f"part-id or method: {row!r}"
                    )

                body, lock = _resolve_entry_point(comp, part_id, entry)

                for harness in harnesses:
                    try:
                        rel, real = adapters.realize(method, harness, part_id)
                    except (adapters.UnknownMethod, adapters.NoRealization) as exc:
                        skipped.append({
                            "component": f"{mod.name}/{comp.name}", "part": part_id,
                            "method": method, "harness": harness, "reason": str(exc),
                        })
                        continue
                    if adapters.is_structured_file(method):
                        # A marker block is not valid JSON; writing one here would
                        # corrupt the workspace's own config. Refuse the row, keep
                        # every other row installing.
                        skipped.append({
                            "component": f"{mod.name}/{comp.name}", "part": part_id,
                            "method": method, "harness": harness,
                            "reason": (
                                f"method {method!r} targets the structured config file "
                                f"{rel} — merging into it needs the harness-config schema, "
                                "which is Phase-3/4 design output and does not exist yet. "
                                "Refused rather than corrupting the file with a marker block."
                            ),
                        })
                        continue
                    dest = target / rel
                    shared = adapters.is_shared_file(method)
                    actions.append({
                        "module": mod.name, "component": comp.name, "part": part_id,
                        "method": method, "harness": harness, "path": str(dest),
                        "native": real.native, "shared_file": shared,
                        "note": real.note, "lock": lock,
                    })
                    if dry_run:
                        continue
                    if shared:
                        _write_block(dest, part_id, body)
                    elif method == "skill":
                        desc = (row.get("description") or "").strip()
                        _write_whole(dest, _skill_file(body, part_id, desc))
                    else:
                        _write_whole(dest, body)

    state = []
    for mod_name in {a["module"] for a in actions}:
        state += _install_state(target, mod_name, [a for a in actions if a["module"] == mod_name], dry_run)

    return {
        "catalog_root": str(root), "target": str(target),
        "harnesses": harnesses, "dry_run": dry_run,
        "modules": sorted({a["module"] for a in actions}),
        "actions": actions, "skipped": skipped, "install_state": state,
        "version_scheme": catalog.STANDIN_VERSION_PREFIX + "<12>  (STAND-IN pending CMP-5 — G-109)",
    }


def _resolve_entry_point(comp: catalog.Component, part_id: str, entry: str) -> tuple[str, dict]:
    """An entry-point cell is either `<catalog>.csv#<row-id>` or a file path.

    The catalog-row form is the assembled body (content is a file, arrangement is
    a row); the file form is delivered in place.
    """
    if not entry:
        raise Refusal(
            f"exposure row {part_id!r} has an empty entry-point — CMP-12 resolves "
            "the METHOD; the manifest must still say WHAT is exposed"
        )
    if "#" in entry:
        cat_file, _, row_id = entry.partition("#")
        cat_name = cat_file.strip().removesuffix(".csv")
        try:
            return catalog.assemble(comp, cat_name, row_id.strip())
        except catalog.CatalogError as exc:
            raise Refusal(str(exc)) from exc
    src = comp.path / entry
    if not src.exists():
        raise Refusal(f"entry-point file does not exist: {src}")
    return src.read_text(encoding="utf-8"), {}


# ---------------------------------------------------------------- commands


def cmd_list(args) -> int:
    root = Path(args.catalog_root).resolve()
    modules = catalog.discover(root)
    out = {"catalog_root": str(root), "modules": {}}
    for mod in modules.values():
        out["modules"][mod.name] = {
            "entry_point": str(mod.entry_point) if mod.entry_point else None,
            "components": {
                c.name: {
                    "exposure_rows": len(c.exposure_rows()),
                    "cognitive_units": len(c.units),
                    "catalogs": sorted(
                        p.stem for p in c.path.glob("*.csv")
                    ),
                }
                for c in mod.components.values()
            },
        }
    if args.json:
        print(json.dumps(out, indent=2))
    else:
        print(f"catalog root: {root}")
        if not modules:
            print("  (no KG-shape module — a module is a directory holding module.md)")
        for name, m in out["modules"].items():
            print(f"  module {name}")
            for cname, c in m["components"].items():
                print(f"    {cname}: {c['exposure_rows']} exposure row(s), "
                      f"{c['cognitive_units']} unit(s), catalogs={','.join(c['catalogs']) or '-'}")
    return 0


def cmd_install(args) -> int:
    root = Path(args.catalog_root).resolve()
    target = Path(args.target).resolve()
    if not target.is_dir():
        raise Refusal(f"--target is not a directory: {target}")
    harnesses = [h.strip() for h in args.harness.split(",") if h.strip()]
    for h in harnesses:
        if h not in adapters.HARNESSES:
            raise Refusal(
                f"harness {h!r} is not built — CON-2 bounds the build to "
                f"{', '.join(adapters.HARNESSES)}"
            )
    result = do_install(root, target, args.module, args.component, harnesses, args.dry_run)
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        tag = "DRY-RUN " if args.dry_run else ""
        print(f"{tag}installed from {root} -> {target}")
        for a in result["actions"]:
            native = "native" if a.get("native") else "fallback"
            print(f"  {a['harness']:9s} {a['method']:10s} {a['part']:28s} {native:8s} {a['path']}")
        for s in result["skipped"]:
            print(f"  skipped: {s.get('part', s.get('component'))} — {s['reason']}")
        print(f"  install state: {len(result['install_state'])} file(s)")
    return 0


def cmd_doctor(args) -> int:
    root = Path(args.catalog_root).resolve()
    findings = []
    ok = True
    if not root.is_dir():
        findings.append(f"REFUSE  --catalog-root is not a directory: {root}")
        ok = False
    else:
        try:
            modules = catalog.discover(root)
        except catalog.CatalogError as exc:
            findings.append(f"REFUSE  {exc}")
            modules, ok = {}, False
        if not modules:
            findings.append("WARN    no KG-shape module (a module is a directory holding module.md)")
        for mod in modules.values():
            for comp in mod.components.values():
                if not comp.exposure_rows():
                    findings.append(f"note    {mod.name}/{comp.name}: no exposure.csv — exposes nothing")
    idx = root / "cognitive-units-index.csv"
    if not idx.exists():
        findings.append(
            "DIVERGENCE  cognitive-units-index.csv absent (CMP-5 / issue G-109) — "
            f"version resolution falls back to the STAND-IN {catalog.STANDIN_VERSION_PREFIX}<12>"
        )
    for line in findings:
        print(line)
    print(f"catalog root: {root}")
    return 0 if ok else 1


# ---------------------------------------------------------------- selftest


def cmd_selftest(args) -> int:
    """Mechanics only, on this tool's OWN fixtures — never on a live install."""
    passes, failures = 0, []

    def check(name, cond, detail=""):
        nonlocal passes
        if cond:
            passes += 1
            print(f"PASS  {name}")
        else:
            failures.append(f"{name}: {detail}")
            print(f"FAIL  {name} — {detail}")

    # --- adapter matrix
    for method in adapters.CANONICAL_METHODS:
        check(f"matrix has canonical method {method}", method in adapters.MATRIX)
    rel, _ = adapters.realize("skill", "claude", "x")
    check("skill/claude realizes natively", rel == ".claude/skills/x/SKILL.md", rel)
    rel, real = adapters.realize("rule", "codex", "y")
    check("rule/codex is a fallback", rel == ".agents/behavior-rules/y.md" and not real.native, rel)
    try:
        adapters.realize("hook", "opencode", "z")
        check("hook/opencode refuses", False, "did not raise")
    except adapters.NoRealization:
        check("hook/opencode refuses", True)
    try:
        adapters.realize("wishful", "claude", "z")
        check("unknown method refuses", False, "did not raise")
    except adapters.UnknownMethod:
        check("unknown method refuses", True)
    check("only agents.md is marker-edited",
          adapters.is_shared_file("agents.md")
          and not adapters.is_shared_file("skill")
          and not adapters.is_shared_file("hook")
          and not adapters.is_shared_file("config"))
    check("hook/config are structured files, never marker-edited",
          adapters.is_structured_file("hook") and adapters.is_structured_file("config")
          and not adapters.is_structured_file("agents.md"))

    # --- fixture: a minimal KG-shape catalog root, built here, owned here
    with tempfile.TemporaryDirectory() as td:
        root = Path(td) / "root"
        comp = root / "demo" / "widget"
        (comp / "prompts" / "cognitive-units" / "roles").mkdir(parents=True)
        (comp / "prompts" / "cognitive-units" / "procedures").mkdir(parents=True)
        (root / "demo" / "module.md").write_text(
            "---\ndescription: demo module\n---\n\n# demo\n", encoding="utf-8")
        (comp / "component.md").write_text("# widget\n", encoding="utf-8")
        # NOTE: file stem deliberately != declared id, the live mirror's shape.
        (comp / "prompts" / "cognitive-units" / "roles" / "w.md").write_text(
            "---\nid: widget-role\ndescription: r\n---\n\nROLE BODY\n", encoding="utf-8")
        (comp / "prompts" / "cognitive-units" / "procedures" / "p.md").write_text(
            "---\nid: widget-proc\ndescription: p\n---\n\nPROC BODY\n", encoding="utf-8")
        (comp / "prompts.csv").write_text(
            "prompt-id,role,procedure,description\n"
            "widget-prompt,widget-role@latest,widget-proc@latest,demo\n", encoding="utf-8")
        (comp / "exposure.csv").write_text(
            "part-id,part-kind,method,rbtv-cli,entry-point,description\n"
            "widget-prompt,prompt,skill,exhibit,prompts.csv#widget-prompt,a demo skill\n",
            encoding="utf-8")

        mods = catalog.discover(root)
        check("discover finds the module", "demo" in mods, sorted(mods))
        widget = mods["demo"].components["widget"]
        check("units indexed by DECLARED id, not filename",
              set(widget.units) == {"widget-role", "widget-proc"}, sorted(widget.units))

        body, lock = catalog.assemble(widget, "prompts", "widget-prompt")
        check("assembly is in column order", body.startswith("ROLE BODY") and "PROC BODY" in body,
              repr(body[:40]))
        check("assembly strips frontmatter", "id: widget-role" not in body)
        check("lock freezes both units content-addressed",
              len(lock) == 2 and all(v.startswith(catalog.STANDIN_VERSION_PREFIX) for v in lock.values()),
              lock)

        # a pinned version must refuse — there is no index to resolve it
        (comp / "prompts.csv").write_text(
            "prompt-id,role,description\nwidget-prompt,widget-role@v3,demo\n", encoding="utf-8")
        try:
            catalog.assemble(widget, "prompts", "widget-prompt")
            check("a pinned version refuses (no index)", False, "did not raise")
        except catalog.CatalogError as exc:
            check("a pinned version refuses (no index)", "G-109" in str(exc), str(exc)[:60])
        (comp / "prompts.csv").write_text(
            "prompt-id,role,procedure,description\n"
            "widget-prompt,widget-role@latest,widget-proc@latest,demo\n", encoding="utf-8")

        # a duplicate declared id must refuse rather than pick by directory order
        dup = comp / "prompts" / "cognitive-units" / "roles" / "dup.md"
        dup.write_text("---\nid: widget-role\n---\n\nX\n", encoding="utf-8")
        try:
            catalog.discover(root)
            check("duplicate unit id refuses", False, "did not raise")
        except catalog.CatalogError:
            check("duplicate unit id refuses", True)
        dup.unlink()

        # --- end-to-end install into a throwaway target
        target = Path(td) / "ws"
        target.mkdir()
        res = do_install(root, target, None, None, ["claude", "codex"], dry_run=False)
        skill = target / ".claude" / "skills" / "widget-prompt" / "SKILL.md"
        check("exposure row realized on claude", skill.exists(), str(skill))
        check("realized body is the ASSEMBLED units",
              skill.exists() and "ROLE BODY" in skill.read_text() and "PROC BODY" in skill.read_text())
        check("module entry point installed as the discovery skill",
              (target / ".claude" / "skills" / "rbtv-demo" / "SKILL.md").exists())
        check("codex got its own realization",
              (target / ".agents" / "skills" / "widget-prompt" / "SKILL.md").exists())
        check("CMP-1 install state seeded",
              (target / ".rbtv" / "modules" / "demo" / "status.json").exists())
        check("settings-history appended",
              (target / ".rbtv" / "modules" / "demo" / "settings-history.jsonl").exists())
        check("server.json is NOT written (daemon's file)",
              not (target / ".rbtv" / "modules" / "demo" / "server.json").exists())

        # --- shared-file safety: a hand-authored CLAUDE.md must survive
        (comp / "exposure.csv").write_text(
            "part-id,part-kind,method,rbtv-cli,entry-point,description\n"
            "widget-prompt,prompt,agents.md,exhibit,prompts.csv#widget-prompt,\n",
            encoding="utf-8")
        t2 = Path(td) / "ws2"
        t2.mkdir()
        (t2 / "CLAUDE.md").write_text("# HAND AUTHORED\n\nkeep me\n", encoding="utf-8")
        do_install(root, t2, None, None, ["claude"], dry_run=False)
        after = (t2 / "CLAUDE.md").read_text()
        check("agents.md row PRESERVES hand-authored content",
              "HAND AUTHORED" in after and "keep me" in after, after[:60])
        check("agents.md row writes a managed marker block",
              "rbtv-install:start id=widget-prompt" in after)
        do_install(root, t2, None, None, ["claude"], dry_run=False)
        again = (t2 / "CLAUDE.md").read_text()
        check("re-install is idempotent in the shared file",
              again.count("rbtv-install:start id=widget-prompt") == 1,
              again.count("rbtv-install:start id=widget-prompt"))
        check("re-install still preserves hand-authored content", "keep me" in again)

        # --- REGRESSION: a config-method row must never corrupt a real settings.json.
        # This bar FAILS by construction on the pre-fix code, which appended an
        # HTML-comment marker block and left the file unparseable.
        (comp / "exposure.csv").write_text(
            "part-id,part-kind,method,rbtv-cli,entry-point,description\n"
            "widget-prompt,prompt,hook,exhibit,prompts.csv#widget-prompt,\n",
            encoding="utf-8")
        t4 = Path(td) / "ws4"
        (t4 / ".claude").mkdir(parents=True)
        settings = t4 / ".claude" / "settings.json"
        settings.write_text('{"permissions": {"allow": ["Bash(ls:*)"]}}\n', encoding="utf-8")
        before = settings.read_text()
        res4 = do_install(root, t4, None, None, ["claude"], dry_run=False)
        after = settings.read_text()
        check("a hook row leaves settings.json BYTE-IDENTICAL", after == before,
              repr(after[:80]))
        try:
            json.loads(after)
            check("settings.json is still valid JSON", True)
        except json.JSONDecodeError as exc:
            check("settings.json is still valid JSON", False, str(exc))
        check("the refusal names its reason",
              any("Phase-3/4" in s.get("reason", "") for s in res4["skipped"]),
              res4["skipped"])
        check("the module entry point still installed alongside the refusal",
              (t4 / ".claude" / "skills" / "rbtv-demo" / "SKILL.md").exists())
        (comp / "exposure.csv").write_text(
            "part-id,part-kind,method,rbtv-cli,entry-point,description\n"
            "widget-prompt,prompt,agents.md,exhibit,prompts.csv#widget-prompt,\n",
            encoding="utf-8")

        # --- dry-run writes NOTHING
        t3 = Path(td) / "ws3"
        t3.mkdir()
        do_install(root, t3, None, None, ["claude"], dry_run=True)
        check("dry-run writes nothing", not any(t3.iterdir()), sorted(p.name for p in t3.iterdir()))

    print()
    print(f"selftest: {passes} passed, {len(failures)} failed")
    for f in failures:
        print(f"  FAILED: {f}")
    return 0 if not failures else 1


# ---------------------------------------------------------------- entry


def main(argv=None) -> int:
    p = argparse.ArgumentParser(
        prog="rbtv-install",
        description="The second rbtv installer — KG-shape components (CMP-5), "
                    "exposure realized through CMP-12's adapter matrix.")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    sub = p.add_subparsers(dest="cmd", required=True)

    def with_root(sp):
        # --json is accepted on BOTH sides of the subcommand. argparse otherwise
        # refuses `install ... --json` with a usage error, and a caller that pipes
        # the output reads an EMPTY result as an empty install rather than as a
        # failure — which is how a comparison harness passes by producing nothing.
        sp.add_argument("--json", action="store_true", help="machine-readable output")
        sp.add_argument("--catalog-root", required=True,
                        help="the rbtv repo OR an install's .rbtv/mirror/ — "
                             "EXPLICIT and REQUIRED, never inferred")
        return sp

    with_root(sub.add_parser("list", help="what is installable under a catalog root"))
    ip = with_root(sub.add_parser("install", help="install KG-shape components into a workspace"))
    ip.add_argument("--target", required=True, help="the workspace root to install into")
    ip.add_argument("--module", help="restrict to one module")
    ip.add_argument("--component", help="restrict to one component")
    ip.add_argument("--harness", default=",".join(adapters.HARNESSES),
                    help=f"comma-separated; built: {','.join(adapters.HARNESSES)}")
    ip.add_argument("--dry-run", action="store_true", help="report, write nothing")
    with_root(sub.add_parser("doctor", help="can this tool work against this root?"))
    st = sub.add_parser("selftest", help="this tool's own mechanics, on its own fixtures")
    st.add_argument("--json", action="store_true", help=argparse.SUPPRESS)

    args = p.parse_args(argv)
    handler = {"list": cmd_list, "install": cmd_install,
               "doctor": cmd_doctor, "selftest": cmd_selftest}[args.cmd]
    try:
        return handler(args)
    except (Refusal, catalog.CatalogError) as exc:
        print(f"rbtv-install: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
