[Unit]
Description=rbtv ignite agents

[Service]
Type=simple
ExecStart=node @DEPLOY@/core/ignite/capabilities/tools/ignite-agent/daemon.js --workspace @WORKSPACE@
Environment=PATH=@PATH@
EnvironmentFile=@ENV_FILE@
Restart=on-failure
KillMode=process
TimeoutStopSec=90

[Install]
WantedBy=default.target
