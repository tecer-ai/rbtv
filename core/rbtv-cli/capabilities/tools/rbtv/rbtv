#!/usr/bin/env node
'use strict';

// rbtv — the system command. It runs spark, doctor, and selftest, and delegates
// `rbtv install <verb>` to the installer. It does not browse modules or components:
// that is `rbtv install list`. Every action verb delegates; this CLI owns no second
// implementation of a surface that already ships.

const fs = require('fs');
const verbs = require('./lib/verbs');
const { delegate, buildDelegateArgs } = require('./lib/delegate');
const { json, refusal } = require('./lib/render');
const { runSelftest } = require('./lib/selftest');
const { spark } = require('./lib/spark');
const { RBTV_ROOT, rel } = require('./lib/root');

const VERSION = '0.2.1';
const BROWSE = 'rbtv install list';

function topHelp() {
  return [
    'rbtv — run rbtv commands. Browse modules, components, and units with rbtv install list.',
    '',
    'ACT (delegates — no second implementation)',
    `  rbtv install <verb>   manage units here: ${verbs.INSTALL_VERBS
      .filter((v) => v !== 'interactive' && v !== 'selftest').join('|')}`,
    '  rbtv spark <agent>    run an installed agent interactively',
    '',
    'ORIENT',
    '  rbtv doctor           can this tool work here? delegates present?',
    '  rbtv selftest         exercise this CLI\'s own mechanics',
    '',
    'FLAGS',
    '  --json       machine output for doctor and for refusals. A delegated call emits the delegate\'s json.',
    '  -h, --help   this page',
    '  --version    print the version',
    '',
    'Retired, not routed: ignite daemon, ignite ticker, the gateway client, goal, run.',
    '',
    'next: rbtv install list',
    'per-command help: rbtv <verb> -h',
  ].join('\n');
}

function invalid(what, opts, code) {
  if (opts.json) {
    json({
      ok: false,
      error: { code, message: what },
      changed: false,
      next: BROWSE,
    });
    return 2;
  }
  console.error(`RBTV — invalid command\n\n${what} Nothing changed.\nFix: ${BROWSE}\nFor top-level commands: rbtv -h`);
  return 2;
}

function consumeFlags(flags, opts) {
  for (const f of flags) {
    if (f === '--json') opts.json = true;
    else if (f === '--help' || f === '-h') opts.helpRequested = true;
    else if (f === '--version') opts.versionRequested = true;
    else if (f === '--rules') opts.rules = true;
    else opts.unknownFlag = f;
  }
}

function main(argvIn) {
  const argv = [...argvIn];
  const opts = { json: false, rules: false, unknownFlag: null };

  const lead = [];
  while (argv.length && argv[0].startsWith('-')) lead.push(argv.shift());
  consumeFlags(lead, opts);
  if (opts.rules) return invalid('`--rules` is not an rbtv flag.', opts, 'unknown-flag');
  if (opts.unknownFlag) {
    return invalid(`\`${opts.unknownFlag}\` is not an rbtv flag.`, opts, 'unknown-flag');
  }
  if (opts.helpRequested) { console.log(topHelp()); return 0; }
  if (opts.versionRequested) { console.log(VERSION); return 0; }

  if (argv.length === 0) { console.log(topHelp()); return 0; }

  const head = argv[0];
  if (head === 'doctor') return doctor(opts);
  if (head === 'selftest') return runSelftest();
  if (head === 'spark') return spark(argv.slice(1), opts);
  if (head === 'status') {
    consumeFlags(argv.slice(1).filter((t) => t.startsWith('-')), opts);
    if (opts.rules) return invalid('`--rules` is not an rbtv flag.', opts, 'unknown-flag');
    if (opts.unknownFlag) return invalid(`\`${opts.unknownFlag}\` is not an rbtv flag.`, opts, 'unknown-flag');
    const next = 'rbtv install status --target "<workspace>"';
    if (opts.json) {
      json({
        ok: false,
        error: { code: 'wrong-command', message: 'status belongs to rbtv install' },
        changed: false,
        next,
      });
      return 2;
    }
    console.error('RBTV — invalid command\n\nstatus belongs to rbtv install. Nothing changed.\n'
      + `Fix: ${next}\nFor top-level commands: rbtv -h`);
    return 2;
  }

  const route = verbs.matchRoute(argv);
  if (route) return runRoute(route, argv, opts);

  if (argv.includes('--rules')) return invalid('`--rules` is not an rbtv flag.', opts, 'unknown-flag');
  return invalid(`\`${head}\` is not an rbtv command.`, opts, 'unknown-command');
}

function runRoute(route, argv, opts) {
  const rest = argv.slice(route.prefix.length);

  if (rest.length === 0) {
    return delegate(route, ['--help']).status || 0;
  }

  const res = delegate(route, buildDelegateArgs(rest, opts));
  if (res.message) console.error(res.message);
  return res.status;
}

function doctor(opts) {
  if (!fs.existsSync(RBTV_ROOT)) {
    const text = refusal({
      what: 'the rbtv root is not a directory, so delegates cannot be found',
      why: `resolved rbtv root: ${RBTV_ROOT}\n       that root is derived from this script's own location, which is wrong if the tool was copied or moved.`,
      fix: 'run the tool from its place in the rbtv tree, or point it at the tree explicitly:',
      escape: 'RBTV_ROOT=/path/to/rbtv rbtv doctor',
    });
    if (opts.json) {
      json({ ok: false, version: VERSION, error: { code: 'no-root', message: text }, root: RBTV_ROOT });
      return 1;
    }
    console.error(text);
    return 1;
  }

  const checks = [];
  const push = (name, ok, detail) => checks.push({ name, ok, detail });

  push('rbtv root resolved', true, RBTV_ROOT);

  for (const r of verbs.ROUTES) {
    const present = fs.existsSync(r.target);
    let exec = false;
    if (present && r.exec === 'direct') {
      try { fs.accessSync(r.target, fs.constants.X_OK); exec = true; } catch { exec = false; }
    }
    const ok = present && (r.exec === 'node' || exec);
    push(
      `delegate: ${r.prefix.join(' ')}`,
      ok,
      ok ? rel(r.target)
        : present ? `present but not executable: ${rel(r.target)} (fix: chmod +x)`
          : `MISSING: ${rel(r.target)}`,
    );
  }

  push('node', true, process.version);
  push('auth (this CLI)', true, 'none required — local commands only');
  push('auth (delegated gateway)', true,
    `IGNITE_SENDER_TOKEN ${process.env.IGNITE_SENDER_TOKEN ? 'set in env' : 'not set in env'}`
    + ` · IGNITE_GATEWAY_ADDR ${process.env.IGNITE_GATEWAY_ADDR ? 'set' : 'not set'}`);

  const ok = checks.every((c) => c.ok);
  if (opts.json) {
    json({ ok, version: VERSION, checks });
    return ok ? 0 : 1;
  }
  for (const c of checks) console.log(`${c.ok ? 'ok  ' : 'FAIL'}  ${c.name}: ${c.detail}`);
  console.log(`\n${ok ? 'ok' : 'FAIL'} — ${checks.filter((c) => c.ok).length}/${checks.length} checks`);
  console.log(ok ? 'next: rbtv install list' : 'next: fix the FAIL lines above, then rerun `rbtv doctor`');
  return ok ? 0 : 1;
}

try {
  process.exitCode = main(process.argv.slice(2));
} catch (err) {
  console.error(`INTERNAL: ${err.stack || err.message}`);
  process.exitCode = 1;
}
