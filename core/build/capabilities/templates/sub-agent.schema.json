{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "harness-native sub-agent frontmatter",
  "description": "The frontmatter of a harness-native sub-agent file a component ships in its agents folder.",
  "type": "object",
  "required": ["name", "description"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
