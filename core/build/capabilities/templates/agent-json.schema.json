{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent.json",
  "type": "object",
  "required": ["name", "description", "harness", "model", "effort", "units", "packs"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "description": {"type": "string", "minLength": 1},
    "harness": {"type": "string", "enum": ["claude", "codex", "opencode"]},
    "model": {"type": "string", "minLength": 1},
    "effort": {"type": "string", "minLength": 1},
    "voice": {"type": "string"},
    "units": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "packs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
