#!/usr/bin/env bash
# rbtv-ctx-monitor — thin wrapper over team-monitor's per-pane sensing ENGINE.
#
# ⚠ THIS IS NOT A SECOND COMPONENT. `ctx-monitor` is the LEGACY ALIAS of CMP-20
# `team-monitor` (renamed at the 2026-07-25 settle sitting, R24) and resolves to
# that same record — `sd-graph show ctx-monitor` proves it. On disk it is the
# ENGINE this capability's sensor imports by path: team_monitor.py:43 sets
# SENSOR_PATH to it and :525 asserts "sensor is the ctx-monitor engine, not a
# copy". It ships here, inside team-monitor's tool/, precisely so the runnable
# stays reachable WITHOUT `rbtv orchestration` publishing a component named with
# a name the registry retired (leader ruling, core-build task 7.40, #852).
#
# It is separately runnable and useful on its own: the harness-agnostic
# outside-observer audit of a live team's panes (harness, model, context used).
#
# v1 exposure stand-in — the implementation stays at orchestration/cli/ctx-monitor/
# by rbtv/CLAUDE.md § CLI Tool Placement, which names that path explicitly and
# rules it stays put until the Phase-6 migration materializes the CMP-5 tree.
set -euo pipefail
here="$(dirname "$(readlink -f "$0")")"
target="$here/../../../cli/ctx-monitor/ctx_monitor.py"
if [ ! -f "$target" ]; then
  echo "rbtv-ctx-monitor: implementation not found at $target" >&2
  echo "  (this wrapper resolves it relative to its own location; if the Phase-6" >&2
  echo "   migration moved orchestration/cli/ctx-monitor/, repoint this wrapper.)" >&2
  exit 2
fi
exec python3 "$target" "$@"
